+// On this AFE the PGA gains are 0x02-0x04 and the offsets 0x05-0x07.
+void test_gl128_frontend_layout()
+{
+    const Genesys_Frontend* fe = nullptr;
+    for (const auto& f : *s_frontends) {
+        if (f.id == AdcId::PLUSTEK_OPTICFILM_8200I_SE) {
+            fe = &f;
+        }
+    }
+    ASSERT_TRUE(fe != nullptr);
+    Genesys_Frontend copy = *fe;
+    copy.set_gain(0, 27);
+    copy.set_gain(1, 12);
+    copy.set_gain(2, 26);
+    copy.set_offset(0, 30);
+    copy.set_offset(1, 0x133);
+    copy.set_offset(2, 29);
+    ASSERT_EQ(copy.regs.get_value(0x02), 27);
+    ASSERT_EQ(copy.regs.get_value(0x03), 12);
+    ASSERT_EQ(copy.regs.get_value(0x04), 26);
+    ASSERT_EQ(copy.regs.get_value(0x05), 30);
+    ASSERT_EQ(copy.regs.get_value(0x06), 0x133);
+    ASSERT_EQ(copy.regs.get_value(0x07), 29);
+}
