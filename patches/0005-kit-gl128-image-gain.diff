@@ -430,6 +430,24 @@ void test_gl128_afe_warmup_settle()
     ASSERT_TRUE(gl128::gl128_strip_settled(a, a, 0.0));
 }
 
+void test_gl128_image_gain_codes()
+{
+    double actual = 0;
+    ASSERT_EQ(gl128::gl128_gain_code_for_factor(26, 1.0, &actual), 26);
+    ASSERT_EQ(actual, 1.0);
+    // gain(12) = 75.6/63.6 = 1.189; x2 -> at most 2.377 -> code 43 (2.319x gain, 1.95x factor).
+    ASSERT_EQ(gl128::gl128_gain_code_for_factor(12, 2.0, &actual), 43);
+    ASSERT_TRUE(actual <= 2.0 && actual > 1.9);
+    for (int c = 0; c <= 63; c += 7) {
+        for (double k : { 1.1, 1.5, 3.0, 8.0 }) {
+            int out = gl128::gl128_gain_code_for_factor(c, k, &actual);
+            ASSERT_TRUE(out >= c && out <= 63);
+            ASSERT_TRUE(actual <= k + 1e-9);
+        }
+    }
+    ASSERT_EQ(gl128::gl128_gain_code_for_factor(26, 8.0, &actual), 63);
+}
