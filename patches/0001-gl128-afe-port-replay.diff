+// The frontend bridge registers are commands, so asic_boot() must not leave
+// them in dev->reg, which shared code writes back to the scanner as a whole.
+void test_gl128_boot_does_not_cache_fe_bridge()
+{
+    Gl128Fixture f;
+    f.dev.interface.reset(new TestScannerInterface(&f.dev, 0x07b3, 0x1825, 0));
+    for (unsigned i = 0; i < 8; i++) {
+        f.dev.frontend_initial.regs.set_value(i, 0);
+    }
+    f.cmd_set.asic_boot(&f.dev, false);
+
+    ASSERT_FALSE(f.dev.reg.has_reg(gl128::REG_FE_INDEX));
+    ASSERT_FALSE(f.dev.reg.has_reg(gl128::REG_FE_HIGH));
+    ASSERT_FALSE(f.dev.reg.has_reg(gl128::REG_FE_LOW));
+}
+
+namespace {
+
+// Records AFE registers the way write_fe_register() programs them: 0x51
+// selects the AFE register and 0x5e commits 0x5d:0x5e to it.
+class AfeBridgeInterface : public TestScannerInterface
+{
+public:
+    explicit AfeBridgeInterface(Genesys_Device* dev) :
+        TestScannerInterface(dev, 0x07b3, 0x1825, 0)
+    {}
+
+    void write_register(std::uint16_t address, std::uint8_t value) override
+    {
+        TestScannerInterface::write_register(address, value);
+        if (address == gl128::REG_FE_INDEX) {
+            index_ = value & 0x07;
+        } else if (address == gl128::REG_FE_HIGH) {
+            high_ = value;
+        } else if (address == gl128::REG_FE_LOW) {
+            afe[index_] = static_cast<std::uint16_t>((high_ << 8) | value);
+        }
+    }
+
+    // ScannerInterfaceUsb writes GL128 register sets one register at a time,
+    // in order.
+    void write_registers(const Genesys_Register_Set& regs) override
+    {
+        for (const auto& reg : regs) {
+            write_register(reg.address, reg.value);
+        }
+    }
+
+    void write_fe_register(std::uint8_t address, std::uint16_t value) override
+    {
+        write_register(gl128::REG_FE_INDEX, address);
+        write_register(gl128::REG_FE_HIGH, (value >> 8) & 0xff);
+        write_register(gl128::REG_FE_LOW, value & 0xff);
+    }
+
+    std::array<std::uint16_t, 8> afe{};
+
+private:
+    unsigned index_ = 0;
+    std::uint8_t high_ = 0;
+};
+
+} // namespace
+
+// genesys_start_scan() writes dev->reg after set_fe(); that must not change
+// the AFE registers set_fe() programmed.
+void test_gl128_afe_survives_register_flush()
+{
+    Gl128Fixture f;
+    auto* iface = new AfeBridgeInterface(&f.dev);
+    f.dev.interface.reset(iface);
+    for (unsigned i = 0; i < 8; i++) {
+        f.dev.frontend_initial.regs.set_value(i, 0);
+    }
+    f.cmd_set.asic_boot(&f.dev, false);
+
+    const std::uint16_t afe[8] = { 0xf8, 0x80, 41, 35, 42, 0x137, 0x136, 61 };
+    for (unsigned i = 0; i < 8; i++) {
+        f.dev.frontend.regs.set_value(i, afe[i]);
+    }
+    f.cmd_set.set_fe(&f.dev, sensor_for(7200), AFE_SET);
+    for (unsigned i = 0; i < 8; i++) {
+        ASSERT_EQ(iface->afe[i], afe[i]);
+    }
+
+    f.dev.interface->write_registers(f.dev.reg);
+    for (unsigned i = 0; i < 8; i++) {
+        ASSERT_EQ(iface->afe[i], afe[i]);
+    }
+}
