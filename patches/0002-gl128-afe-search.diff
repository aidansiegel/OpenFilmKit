+// --- AFE gain/offset search ----------------------------------------------------
+// SilverFast measures the front end before it scans instead of using fixed codes: offsets that
+// put the shielded optical-black pixels just above 0 at gain 0, PGA gains from a lamp-on strip
+// read at gain 0, then offsets that put optical black at 0x500 at those gains. pyopticfilm
+// recovered the method from SilverFast's USB captures (pyopticfilm PR #119, #130) and replays
+// SilverFast's own searches within one gain code. Fixed codes copied from one SilverFast session
+// leave red and blue at the 16-bit ceiling on the white strip (shading gain 1, no correction)
+// and green short of it, so the shading table makes up green digitally, and the unused green
+// codes that leaves change over a session.
+
+int gl128_decode_afe_offset(unsigned code)
+{
+    int magnitude = static_cast<int>(code & 0xff);
+    return (code & 0x100) ? -magnitude : magnitude;
+}
+
+unsigned gl128_encode_afe_offset(int value)
+{
+    int v = std::max(-0xff, std::min(0xff, value));
+    return v < 0 ? (0x100u | static_cast<unsigned>(-v)) : static_cast<unsigned>(v);
+}
+
+bool gl128_offset_for_black(double at_low, double at_high, int low_code, int high_code,
+                            double target, int* offset)
+{
+    const double per_code = (at_high - at_low) / static_cast<double>(high_code - low_code);
+    if (!(per_code >= 4.0)) {
+        return false;
+    }
+    // nearbyint() rounds half to even, as pyopticfilm's round() does.
+    double value = std::nearbyint(low_code + (target - at_low) / per_code);
+    *offset = static_cast<int>(std::max(-255.0, std::min(255.0, value)));
+    return true;
+}
+
+int gl128_gain_for_wide_mean(double mean, double target)
+{
+    int code = static_cast<int>(std::floor(75.6 - 75.6 * mean / target));
+    return std::max(0, std::min(0x3f, code));
+}
+
+bool gl128_strip_settled(const std::array<double, 3>& previous, const std::array<double, 3>& current,
+                         double tolerance)
+{
+    for (int c = 0; c < 3; c++) {
+        double base = std::max(1.0, previous[c]);
+        if (!(std::abs(current[c] - previous[c]) <= tolerance * base)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+std::array<double, 3> gl128_chunky_means(const std::vector<std::uint8_t>& strip, unsigned pixels)
+{
+    const std::size_t expected = static_cast<std::size_t>(pixels) * 6;
+    if (pixels == 0 || strip.size() < expected) {
+        throw SaneException("GL128: AFE strip too short: %zu < %zu", strip.size(), expected);
+    }
+    double sums[3] = { 0.0, 0.0, 0.0 };
+    for (unsigned i = 0; i < pixels; i++) {
+        for (int c = 0; c < 3; c++) {
+            std::size_t off = static_cast<std::size_t>(i) * 6 + c * 2;
+            sums[c] += static_cast<double>(strip[off] | (strip[off + 1] << 8));
+        }
+    }
+    return { sums[0] / pixels, sums[1] / pixels, sums[2] / pixels };
+}
+
+std::array<double, 3> gl128_optical_black_means(const std::vector<std::uint8_t>& strip,
+                                                unsigned pixels)
+{
+    // Columns 0-59 are shielded; pyopticfilm averages 2-55 (AFE_OPTICAL_BLACK_COLUMNS).
+    constexpr unsigned first = 2, end = 56;
+    if (pixels < end || strip.size() < static_cast<std::size_t>(end) * 6) {
+        throw SaneException("GL128: AFE strip too short for optical black: %u px", pixels);
+    }
+    double sums[3] = { 0.0, 0.0, 0.0 };
+    for (unsigned i = first; i < end; i++) {
+        for (int c = 0; c < 3; c++) {
+            std::size_t off = static_cast<std::size_t>(i) * 6 + c * 2;
+            sums[c] += static_cast<double>(strip[off] | (strip[off + 1] << 8));
+        }
+    }
+    const double n = end - first;
+    return { sums[0] / n, sums[1] / n, sums[2] / n };
+}
