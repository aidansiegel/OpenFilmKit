+    std::vector<std::uint8_t> strip(px * 6, 0);
+    auto put = [&](unsigned x, int c, unsigned v) {
+        strip[x * 6 + c * 2] = static_cast<std::uint8_t>(v & 0xff);
+        strip[x * 6 + c * 2 + 1] = static_cast<std::uint8_t>(v >> 8);
+    };
+    for (unsigned x = 0; x < px; x++) {
+        bool black = x >= 2 && x < 56;
+        put(x, 0, black ? 1000 : 40000);
+        put(x, 1, black ? 2000 : 41000);
+        put(x, 2, black ? 3000 : 42000);
+    }
+    auto ob = gl128::gl128_optical_black_means(strip, px);
+    ASSERT_EQ(ob[0], 1000.0);
+    ASSERT_EQ(ob[1], 2000.0);
+    ASSERT_EQ(ob[2], 3000.0);
+    auto all = gl128::gl128_chunky_means(strip, px);
+    ASSERT_TRUE(all[0] > 30000.0 && all[1] > all[0] && all[2] > all[1]);
