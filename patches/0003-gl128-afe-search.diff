+// gain; false when the probe barely moved (fewer than 4 counts per offset code).
+bool gl128_offset_for_black(double at_low, double at_high, int low_code, int high_code,
+                            double target, int* offset);
+// PGA gain code (0-63) from the mean of the lamp-on strip read at gain 0. The AD9826 PGA gives
+// gain(code) = 75.6 / (75.6 - code), so this is the code whose gain brings `mean` to `target`.
+int gl128_gain_for_wide_mean(double mean, double target);
