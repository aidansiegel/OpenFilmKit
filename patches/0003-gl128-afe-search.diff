+    ASSERT_FALSE(gl128::gl128_strip_settled(a, { 30000.0, 40200.0, 35000.0 }, 0.002));  // green 0.5%
+    ASSERT_FALSE(gl128::gl128_strip_settled({ 0.0, 0.0, 0.0 }, { 500.0, 0.0, 0.0 }, 0.002));
+    ASSERT_TRUE(gl128::gl128_strip_settled(a, a, 0.0));
+}
