+// --- Front-end (AFE) search ---------------------------------------------------
+// SilverFast measures the front end before each scan instead of using fixed codes:
+// offsets that put the shielded optical-black pixels just above 0 at gain 0, PGA gains from a
+// lamp-on strip read at gain 0, then offsets that put optical black at 0x500 at those gains for
+// the dark strip, and a few codes higher for the image. The sequence and its constants are as
+// recorded in SilverFast's USB traffic with the 8200i SE and published by the pyopticfilm
+// project, which replays SilverFast's searches to within one gain code; this is an independent
+// implementation of that method.
+//
+// Fixed codes taken from one SilverFast session don't fit every unit: on one 8200i SE they put
+// the white strip at the 16-bit ceiling in all three channels, so the shading table had no
+// white reference to correct, and green lost 70-84% of its codes, more as the session went on.
+// Searched, every channel's white strip landed within 1% of its target and green kept all but
+// about 1% of its codes, with the same gains over 20 minutes, at 3600 and 7200 dpi.
+
+const Gl128AfeSearch GL128_AFE_SEARCH[] = {
+    {
+        SensorId::CCD_PLUSTEK_OPTICFILM_8200I_SE,
+        // Columns 0-59 of the AFE strip (from STRPIXEL) are shielded; 2-55 are averaged.
+        2, 56,
+        // SilverFast puts optical black at 48 for its gain strip and at 0x500 for its dark strip,
+        // then settles its image offsets 6-8 codes higher: about 230 counts at its gains, so the
+        // image's black stays above 0 after the dark term is subtracted.
+        48.0, 1280.0, 230.0,
+        // SilverFast's gain step aims at 47000/53575/53575 on a strip read straight after idle,
+        // which reads about 7% low; read after a throwaway strip, as here, the same gains come
+        // from these targets.
+        { 50518.0, 55518.0, 56428.0 },
+        8000.0,
+        // Re-read the gain strip until no channel moves more than 0.2%, at most 8 times.
+        0.002, 8,
+    },
+};
+
+const Gl128AfeSearch* gl128_afe_search_for(SensorId sensor_id)
+{
+    for (const auto& s : GL128_AFE_SEARCH) {
+        if (s.sensor_id == sensor_id) {
+            return &s;
+        }
+    }
+    return nullptr;
+}
+
+int gl128_decode_afe_offset(unsigned code)
+{
+    int magnitude = static_cast<int>(code & 0xff);
+    return (code & 0x100) ? -magnitude : magnitude;
+}
+
+unsigned gl128_encode_afe_offset(int value)
+{
+    int v = std::max(-0xff, std::min(0xff, value));
+    return v < 0 ? (0x100u | static_cast<unsigned>(-v)) : static_cast<unsigned>(v);
+}
+
+bool gl128_offset_for_black(double at_low, double at_high, int low_code, int high_code,
+                            double target, int* offset)
+{
+    const double per_code = (at_high - at_low) / static_cast<double>(high_code - low_code);
+    if (!(per_code >= 4.0)) {
+        return false;
+    }
+    // nearbyint() rounds half to even.
+    double value = std::nearbyint(low_code + (target - at_low) / per_code);
+    *offset = static_cast<int>(std::max(-255.0, std::min(255.0, value)));
+    return true;
+}
+
+int gl128_gain_for_wide_mean(double mean, double target)
+{
+    int code = static_cast<int>(std::floor(75.6 - 75.6 * mean / target));
+    return std::max(0, std::min(0x3f, code));
+}
+
+std::array<double, 3> gl128_chunky_means(const std::vector<std::uint8_t>& strip, unsigned pixels,
+                                         unsigned first, unsigned end)
+{
+    if (first >= end || end > pixels || strip.size() < static_cast<std::size_t>(end) * 6) {
+        throw SaneException("GL128: AFE strip too short: %zu bytes for columns %u-%u",
+                            strip.size(), first, end);
+    }
+    double sums[3] = { 0.0, 0.0, 0.0 };
+    for (unsigned i = first; i < end; i++) {
+        for (int c = 0; c < 3; c++) {
+            std::size_t off = static_cast<std::size_t>(i) * 6 + c * 2;
+            sums[c] += static_cast<double>(strip[off] | (strip[off + 1] << 8));
+        }
+    }
+    const double n = end - first;
+    return { sums[0] / n, sums[1] / n, sums[2] / n };
+}
+
+std::array<double, 3> gl128_chunky_means(const std::vector<std::uint8_t>& strip, unsigned pixels)
+{
+    return gl128_chunky_means(strip, pixels, 0, pixels);
+}
+
+bool gl128_strip_settled(const std::array<double, 3>& previous, const std::array<double, 3>& current,
+                         double tolerance)
+{
+    for (int c = 0; c < 3; c++) {
+        double base = std::max(1.0, previous[c]);
+        if (!(std::abs(current[c] - previous[c]) <= tolerance * base)) {
+            return false;
+        }
+    }
+    return true;
+}
