+// --- Front-end (AFE) search -------------------------------------------------
+// Per-device values for measuring the AFE before each scan (see gl128.cpp).
+struct Gl128AfeSearch {
+    SensorId sensor_id;
+    unsigned black_first;               // shielded (optical black) strip columns, first..end-1
+    unsigned black_end;
+    double pre_black;                   // optical black at gain 0, for the gain strip
+    double black;                       // optical black for the dark strip
+    double image_pedestal;              // the image's black this much above the dark strip's
+    std::array<double, 3> white_targets;  // lamp-on strip targets of the gain step, R, G, B
+    double min_lit;                     // a channel below this at gain 0: lamp not lit
+    double settle;                      // warm-up: re-read until no channel moves more than this
+    unsigned max_settle_reads;
+};
+// The search values for a sensor, or nullptr: the device keeps its fixed codes.
+const Gl128AfeSearch* gl128_afe_search_for(SensorId sensor_id);
+
+// AFE offsets (0x05-0x07) are 9-bit sign-magnitude: bit 8 set means negative.
+int gl128_decode_afe_offset(unsigned code);
+unsigned gl128_encode_afe_offset(int value);
