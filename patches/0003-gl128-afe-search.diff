+// Front-end search arithmetic, against the SilverFast capture values published by the
+// pyopticfilm project (measurements; the codes SilverFast wrote for them).
+void test_gl128_afe_offset_codes()
+{
+    ASSERT_EQ(gl128::gl128_decode_afe_offset(0x16a), -106);
+    ASSERT_EQ(gl128::gl128_decode_afe_offset(0x142), -66);
+    ASSERT_EQ(gl128::gl128_decode_afe_offset(0x100), 0);
+    ASSERT_EQ(gl128::gl128_decode_afe_offset(0x45), 69);
+    ASSERT_EQ(gl128::gl128_encode_afe_offset(300), 0xffu);
+    ASSERT_EQ(gl128::gl128_encode_afe_offset(-300), 0x1ffu);
+    ASSERT_EQ(gl128::gl128_encode_afe_offset(-97), 0x161u);
+    ASSERT_EQ(gl128::gl128_encode_afe_offset(15), 15u);
+}
+
+void test_gl128_afe_offset_search()
+{
+    // Probes at gains 35/25/32 (one SilverFast session): optical black at 0x500 takes its codes
+    // 15/23/19 exactly.
+    const double lo[3] = { 5426, 4388, 5023 }, hi[3] = { 10100, 8145, 9366 };
+    const int expected[3] = { 15, 23, 19 };
+    for (int c = 0; c < 3; c++) {
+        int off = 0, image = 0;
+        ASSERT_TRUE(gl128::gl128_offset_for_black(lo[c], hi[c], 0x80, 0xff, 1280.0, &off));
+        ASSERT_EQ(off, expected[c]);
+        // 230 counts higher is 6-8 codes at these gains, as SilverFast settles its image offsets.
+        ASSERT_TRUE(gl128::gl128_offset_for_black(lo[c], hi[c], 0x80, 0xff, 1510.0, &image));
+        ASSERT_TRUE(image - off >= 6 && image - off <= 8);
+    }
+    // Gain 0: within 3 codes of the session's -95/-82/-81.
+    const double plo[3] = { 3526, 3380, 3425 }, phi[3] = { 5491, 5427, 5482 };
+    const int sf[3] = { -95, -82, -81 };
+    for (int c = 0; c < 3; c++) {
+        int off = 0;
+        ASSERT_TRUE(gl128::gl128_offset_for_black(plo[c], phi[c], 0x80, 0xff, 48.0, &off));
+        ASSERT_TRUE(std::abs(off - sf[c]) <= 3);
+    }
+    // A probe that barely moves (or is railed) gives no answer.
+    int off = 0;
+    ASSERT_FALSE(gl128::gl128_offset_for_black(3000, 3001, 0x80, 0xff, 1280.0, &off));
+    ASSERT_FALSE(gl128::gl128_offset_for_black(65535, 65535, 0x80, 0xff, 1280.0, &off));
+}
+
+void test_gl128_afe_gain_search()
+{
+    // Settled gain strips with the targets in the search table, and strips read straight after
+    // idle with SilverFast's own targets: both give that session's gains 35/25/32.
+    const auto* sp = gl128::gl128_afe_search_for(SensorId::CCD_PLUSTEK_OPTICFILM_8200I_SE);
+    ASSERT_TRUE(sp != nullptr);
+    const double settled[3] = { 26821, 36750, 32191 };
+    const double idle[3] = { 24953, 35464, 30563 }, sf[3] = { 47000, 53575, 53575 };
+    const int expected[3] = { 35, 25, 32 };
+    for (int c = 0; c < 3; c++) {
+        ASSERT_EQ(gl128::gl128_gain_for_wide_mean(settled[c], sp->white_targets[c]), expected[c]);
+        ASSERT_EQ(gl128::gl128_gain_for_wide_mean(idle[c], sf[c]), expected[c]);
+    }
+    ASSERT_EQ(gl128::gl128_gain_for_wide_mean(0, 50000), 63);         // clamped
+    ASSERT_EQ(gl128::gl128_gain_for_wide_mean(65535, 50000), 0);
+    ASSERT_TRUE(gl128::gl128_afe_search_for(SensorId::UNKNOWN) == nullptr);
+}
+
+void test_gl128_afe_strip_means()
+{
+    // Interleaved RGB, 16-bit LE: the optical-black columns are averaged on their own.
+    const unsigned px = 512;
+    std::vector<std::uint8_t> strip(px * 6, 0);
+    auto put = [&](unsigned x, int c, unsigned v) {
+        strip[x * 6 + c * 2] = static_cast<std::uint8_t>(v & 0xff);
+        strip[x * 6 + c * 2 + 1] = static_cast<std::uint8_t>(v >> 8);
+    };
+    for (unsigned x = 0; x < px; x++) {
+        bool black = x >= 2 && x < 56;
+        put(x, 0, black ? 1000 : 40000);
+        put(x, 1, black ? 2000 : 41000);
+        put(x, 2, black ? 3000 : 42000);
+    }
+    auto ob = gl128::gl128_chunky_means(strip, px, 2, 56);
+    ASSERT_EQ(ob[0], 1000.0);
+    ASSERT_EQ(ob[1], 2000.0);
+    ASSERT_EQ(ob[2], 3000.0);
+    auto all = gl128::gl128_chunky_means(strip, px);
+    ASSERT_TRUE(all[0] > 30000.0 && all[1] > all[0] && all[2] > all[1]);
+    ASSERT_RAISES(gl128::gl128_chunky_means(strip, px, 0, px + 1), SaneException);
+}
+
